+  /* Remove built-in workspaces hidden in game-development builds. */
+  for (WorkSpace &workspace : bmain->workspaces.items_mutable()) {
+    if (!BKE_workspace_is_hidden_builtin(workspace.id.name + 2)) {
+      continue;
+    }
+    bool is_active = false;
+    for (wmWindowManager &wm : bmain->wm) {
+      for (wmWindow &win : wm.windows) {
+        if (BKE_workspace_active_get(win.workspace_hook) == &workspace) {
+          is_active = true;
+        }
+      }
+    }
+    if (!is_active) {
+      BKE_workspace_remove(bmain, &workspace);
+    }
+  }
+
   /* Work-spaces. */
   for (wmWindowManager &wm : bmain->wm) {
     blo_update_defaults_windowmanager(&wm);
